[Unit]
Description=Ionbeam Web Backend
After=network.target glasgow-svc.service
Requires=glasgow-svc.service

[Service]
Type=simple
User=ionbeam
Environment=IONBEAM_WEB_ROOT=%h/Project/IobeamTech/Development/ionbeam-web
EnvironmentFile=%h/Project/IobeamTech/Development/ionbeam-web/backend/.env
Environment=NODE_ENV=production
WorkingDirectory=%h
ExecStart=/usr/bin/env bash -lc 'export NVM_DIR="$HOME/.nvm"; if [ -s "$NVM_DIR/nvm.sh" ]; then . "$NVM_DIR/nvm.sh"; fi; cd "$IONBEAM_WEB_ROOT/backend" && exec npm start'
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
