{
    "VacuumPumps": [
        {
            "name": "MechanicalVacuumPump",
            "power": "off",
            "value": "1.0*e-1",
            "write": "A0",
            "read": "B0"
        },
        {
            "name": "TurboVacuumPump",
            "power": "off",
            "value": "2.0*e-3",
            "write": "A1",
            "read": "B1"
        },
        {
            "name": "UHVacuumPump_1",
            "power": "off",
            "value": "3.0*e-5",
            "write": "A2",
            "read": "B2"
        },
        {
            "name": "UHVacuumPump_2",
            "power": "off",
            "value": "3.0*e-5",
            "write": "A3",
            "read": "B3"
        }
    ],
    "errorRange": "0.01",
    "HighVoltageTransformer": {
        "power": "off",
        "write": "A4"
    },
    "SBC": {
        "Id": "rpi-vacuum-io",
        "voltage": 3.3,
        "Board": "RPi5VacuumIO-A",
        "PiModel": "4B",
        "Channels": {
            "A0": "K1",
            "A1": "K2",
            "A2": "K3",
            "A3": "K4",
            "A4": "K5",
            "B0": "DI1",
            "B1": "DI2",
            "B2": "DI3",
            "B3": "DI4"
        },
        "Faults": {
            "B0": "DI5",
            "B1": "DI6",
            "B2": "DI7",
            "B3": "DI8"
        },
        "Gauges": {
            "B0": {
                "AIN": "AI1",
                "Law": "log",
                "Slope": 1,
                "Offset": -5.5
            },
            "B1": {
                "AIN": "AI2",
                "Law": "log",
                "Slope": 1.667,
                "Offset": -11.33
            },
            "B2": {
                "AIN": "AI3",
                "Law": "log",
                "Slope": 1.667,
                "Offset": -11.33
            },
            "B3": {
                "AIN": "AI4",
                "Law": "log",
                "Slope": 1.667,
                "Offset": -11.33
            }
        },
        "I2CBus": 1,
        "HeartbeatHz": 1000,
        "KeepAliveSeconds": 3,
        "Serial": {
            "RS485": "/dev/ttyAMA0",
            "RS232": "/dev/ttyAMA1"
        }
    },
    "Message": [
        "RPi5VacuumIO rev A.1 board on a Raspberry Pi 4 Model B (PiModel 4B) or Raspberry Pi 5 (PiModel 5).",
        "Channels: logical A outputs -> relays K1..K8; logical B ready inputs -> opto inputs DI1..DI16.",
        "Faults: optional 'healthy = ON' inputs per B channel. An open fault input stops that pump and the cascade.",
        "Gauges: AI input and conversion law. log: p = 10^(Slope*U + Offset); linear: p = Slope*U + Offset.",
        "        Set \"Interlock\": true on a gauge to also require p <= value*(1+errorRange) before the next stage starts.",
        "Serial: Pi 4B -> RS485 /dev/ttyAMA0 (needs dtoverlay=disable-bt), RS232 on uart5 (dtoverlay=uart5, check ls -l /dev/ttyAMA*).",
        "        Pi 5  -> RS485 /dev/ttyAMA0, RS232 /dev/ttyAMA4 (dtoverlay=uart4-pi5).",
        "Enable: CONFIGURATION / GENERAL / Active vacuum control edits this entry.",
        "    true -> activate vacuum control in the mode selected by scan IsProduction.",
        "    false -> disable vacuum control and bypass its scan-readiness gate.",
        "    Read at service start: Configuration Update resets the controller after changing it.",
        "Scan IsProduction selects hardware (true) or emulation (false). Enable controls activation; IsProduction below is the fallback for standalone use."
    ],
    "IsProduction": false,
    "Simulate": false,
    "Enable": false,
    "LogName": "VacuumDashboard",
    "Verbose": false
}
