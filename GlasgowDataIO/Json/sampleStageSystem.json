{
    "Version": "2.0",
    "Enable": true,
    "Simulate": true,
    "Driver": {
        "model": "TMC5160",
        "interface": "SPI",
        "positionSource": "XACTUAL",
        "spiDatagramBits": 40
    },
    "Safety": {
        "maximumTravelInches": 15.0,
        "emergencyStopRequired": true,
        "hardwareLimitSwitchesRequired": true
    },
    "Glasgow": {
        "Device1": {
            "Id": "",
            "voltage": 3.3
        }
    },
    "Axes": {
        "X": {
            "pins": { "sck": "A0", "cs": "A1", "sdi": "A2", "sdo": "A3" },
            "minimum": -50.0,
            "maximum": 50.0,
            "microstepsPerUnit": 51200.0,
            "invertDirection": false,
            "spi": { "frequencyKHz": 500, "sckIdle": 0, "sckEdge": "rising" },
            "motion": {
                "timeoutSeconds": 30.0,
                "pollIntervalMs": 25.0,
                "positionToleranceMicrosteps": 2
            },
            "registerWrites": {
                "GCONF": "0x00000004",
                "GSTAT": "0x00000007",
                "IHOLD_IRUN": "0x00061008",
                "VSTART": 10,
                "A1": 1000,
                "V1": 50000,
                "AMAX": 500,
                "VMAX": 100000,
                "DMAX": 700,
                "D1": 1400,
                "VSTOP": 10,
                "TZEROWAIT": 0,
                "SW_MODE": "0x00000000",
                "CHOPCONF": "0x000100C3",
                "COOLCONF": "0x00000000",
                "PWMCONF": "0xC40C001E"
            }
        },
        "Y": {
            "pins": { "sck": "A4", "cs": "A5", "sdi": "A6", "sdo": "A7" },
            "minimum": -50.0,
            "maximum": 50.0,
            "microstepsPerUnit": 51200.0,
            "invertDirection": false,
            "spi": { "frequencyKHz": 500, "sckIdle": 0, "sckEdge": "rising" },
            "motion": {
                "timeoutSeconds": 30.0,
                "pollIntervalMs": 25.0,
                "positionToleranceMicrosteps": 2
            },
            "registerWrites": {
                "GCONF": "0x00000004",
                "GSTAT": "0x00000007",
                "IHOLD_IRUN": "0x00061008",
                "VSTART": 10,
                "A1": 1000,
                "V1": 50000,
                "AMAX": 500,
                "VMAX": 100000,
                "DMAX": 700,
                "D1": 1400,
                "VSTOP": 10,
                "TZEROWAIT": 0,
                "SW_MODE": "0x00000000",
                "CHOPCONF": "0x000100C3",
                "COOLCONF": "0x00000000",
                "PWMCONF": "0xC40C001E"
            }
        }
