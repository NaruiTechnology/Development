#!/usr/bin/env bash
# Launcher: ensures the repo Development folder is on PYTHONPATH
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# repo root is two levels up from Development/Scripts
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
export PYTHONPATH="$REPO_ROOT/Development${PYTHONPATH:+:$PYTHONPATH}"
exec python3 "$REPO_ROOT/Development/Scripts/program-fpga-ram.py" "$@"
