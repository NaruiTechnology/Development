{
    "Actions":[
        {
            "connectDevice": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "glasgow run control-gpio -V {} --pins {}",
                    "voltage": 3.3,
                    "pins": "A0"
                },
                "timeout": 20.0
            }
        },
        {
            "buildFPGAPlan": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "./build.sh"
                }
            }
        },
        {
            "buildFPGAImage": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {                    
                    "commandFormat": "yosys -p 'synth_ice40 -top top -json top.json' {}",
                    "": "top.v"
                },
                "timeout": 20.0
            }
        },
        {
            "generateFullImage": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "shellCmd": { 
                        "commandFormat": "icepack {} {}"
                    }
                }
            }
        },
        {
            "invokeNextpnr": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "shellCmd": { 
                        "commandFormat": "nextpnr-ice40 --hx8k --package tq144 --json {} --pcf {} --asc {}"
                    }
                }
            }
        },
        {
            "flashImage": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "shellCmd": { 
                        "commandFormat": "glasgow run program-ice40-sram {}"
                    }
                }
            }
        }

    ],
    "LogName": "LoadFPGAImage"
}