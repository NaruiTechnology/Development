SBC_VACUUM_HOST=0.0.0.0
SBC_VACUUM_PORT=8765
SBC_VACUUM_CONFIG=/opt/ionbeam/Development/GlasgowDataIO/Json/vacuumSystem.json
# Standalone mode: no Redis or executor is required. Change to true only when
# deploying the optional active/standby executor topology.
SBC_REQUIRE_FENCING=false
SBC_FENCING_STATE=/var/lib/sbc-vacuum/fencing-token.json
# Set a long random value before exposing the service beyond localhost.
SBC_VACUUM_TOKEN=change-me
# The SBC's own profile (SBC_VACUUM_CONFIG) decides how it runs: Enable
# activates control; Simulate=true selects simulation, false requires SBC
# hardware. This setting is independent of scanner IsProduction.
#SBC_VACUUM_EMULATOR_SPEED=20
#SBC_VACUUM_EMULATOR_MODEL=4B
# Unattended operation: JSON alert webhook (cascade stopped, alarms, controller
# stopped) and the reminder interval while the cascade stays stopped.
#SBC_VACUUM_ALERT_WEBHOOK=https://hooks.example.com/services/...
#SBC_VACUUM_ALERT_TOKEN=
#SBC_VACUUM_ALERT_REMIND_SECONDS=1800
# Healthy polls (about 1 s each) before a device-error stop clears by itself;
# 0 keeps the old behaviour (operator resume only).
#SBC_VACUUM_AUTO_RESUME_POLLS=10
