SBC_VACUUM_HOST=0.0.0.0
SBC_VACUUM_PORT=8765
SBC_VACUUM_CONFIG=/opt/ionbeam/Development/GlasgowDataIO/Json/vacuumSystem.json
# Standalone mode: no Redis or executor is required. Change to true only when
# deploying the optional active/standby executor topology.
SBC_REQUIRE_FENCING=false
SBC_FENCING_STATE=/var/lib/sbc-vacuum/fencing-token.json
# Set a long random value before exposing the service beyond localhost.
SBC_VACUUM_TOKEN=change-me
