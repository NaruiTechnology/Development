VACUUM_EXECUTOR_ID=sbc-a
VACUUM_EXECUTOR_HOST=0.0.0.0
VACUUM_EXECUTOR_PORT=8780
# SBC-local vacuum API. VACUUM_GLASGOW_URL remains a deprecated fallback.
VACUUM_SBC_URL=http://127.0.0.1:8765
GLASGOW_TOKEN=
GLASGOW_REQUIRE_FENCING=true
VACUUM_REDIS_SENTINELS=10.0.0.11:26379,10.0.0.12:26379,10.0.0.13:26379
VACUUM_REDIS_MASTER=vacuum-primary
VACUUM_REDIS_NAMESPACE=vacuum
VACUUM_REDIS_WAIT_REPLICAS=1
VACUUM_REDIS_WAIT_TIMEOUT_MS=1000
VACUUM_EXECUTOR_LEASE_TTL=5
VACUUM_EXECUTOR_POLL_INTERVAL=1
VACUUM_LOG_LEVEL=INFO
