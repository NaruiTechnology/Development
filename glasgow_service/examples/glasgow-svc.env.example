# Glasgow service environment file -- example template.
#
# Copy this file to ONE of:
#
#   C:\Project\IobeamTech\Development\glasgow_service\deploy\glasgow-svc.env
#                              Windows local development. Auto-discovered by
#                              glasgow_service.config.find_config_path.
#
#   /etc/glasgow-svc.env       Linux production. Referenced by
#                              glasgow-svc.service via EnvironmentFile=.
#
# You can also point at an arbitrary location with:
#   PowerShell: $env:GLASGOW_ENV_FILE="C:\some\other\path.env"
#   bash:       export GLASGOW_ENV_FILE=/some/other/path.env

# --- required ---------------------------------------------------------------

# Absolute path to your streamData.json
GLASGOW_CONFIG=C:\Project\IobeamTech\Development\GlasgowDataIO\Json\streamData.json


# --- optional ---------------------------------------------------------------

# Bearer token for the REST endpoints. Leave commented out to run open
# on localhost; set it to require `Authorization: Bearer <token>`.
# Generate with PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# GLASGOW_TOKEN=replace-me-with-32-bytes-of-hex
