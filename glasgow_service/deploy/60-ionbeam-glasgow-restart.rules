// Permit signed-in administrators to restart the local scan and vacuum executor services.
// This lets the Ionbeam user service operate non-interactively without
// granting general passwordless sudo access.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") == "glasgow-svc.service" ||
         action.lookup("unit") == "vacuum-executor.service") &&
        action.lookup("verb") == "restart" &&
        subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
