// Permit signed-in administrators to restart only the local Glasgow service.
// This lets the Ionbeam user service operate non-interactively without
// granting general passwordless sudo access.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "glasgow-svc.service" &&
        action.lookup("verb") == "restart" &&
        subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
