[Unit]
Description=Raspberry Pi vacuum active/standby failover executor
After=network-online.target
Wants=network-online.target
# Keep restarting for 24/7 service: the default start limit (5 starts in
# 10 s) would leave the unit failed for good after a short crash loop,
# for example while the I2C expanders come up at boot.
StartLimitIntervalSec=0

[Service]
Type=exec
User=vboxuser
WorkingDirectory=/home/vboxuser/Project/Operations
Environment=PYTHONPATH=/home/vboxuser/Project/Operations/Development:/home/vboxuser/Project/Operations/Development/glasgow_service
EnvironmentFile=/etc/vacuum-executor.env
ExecStart=/home/vboxuser/Project/Operations/.venv/bin/python -m glasgow_service.vacuum_executor_app
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
