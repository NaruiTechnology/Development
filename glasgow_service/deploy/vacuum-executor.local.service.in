[Unit]
Description=Local vacuum executor
After=network-online.target
Wants=network-online.target
# Keep restarting for 24/7 service: the default start limit (5 starts in
# 10 s) would leave the unit failed for good after a short crash loop,
# for example while the I2C expanders come up at boot.
StartLimitIntervalSec=0

[Service]
Type=exec
User=@ADMIN_USER@
WorkingDirectory=@SERVICE_ROOT@
Environment=PYTHONPATH=@OPERATIONS_ROOT@/Development:@SERVICE_ROOT@
EnvironmentFile=/etc/vacuum-executor.env
# Credentials (GLASGOW_TOKEN, DB, FTP): owner-only file outside the deploy root.
EnvironmentFile=-@SECRETS_FILE@
ExecStart=@PYTHON_BIN@ -m glasgow_service.vacuum_executor_app
StandardOutput=append:@LOG_DIR@/vacuum-executor.log
StandardError=append:@LOG_DIR@/vacuum-executor.log
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
