# /etc/sbc-vacuum.env - written once by install_sbc.py; later installs never overwrite it.
# The host backend reaches this controller at http://<pi>:8766 (VACUUM_CONTROLLER_URL)
# with the same SBC_VACUUM_TOKEN.
SBC_VACUUM_HOST=0.0.0.0
SBC_VACUUM_PORT=8766
SBC_VACUUM_CONFIG=@CONFIG@
SBC_VACUUM_TOKEN=@TOKEN@
# Standalone mode: no Redis or executor is required. Change to true only when
# deploying the optional active/standby executor topology.
SBC_REQUIRE_FENCING=false
SBC_FENCING_STATE=/var/lib/sbc-vacuum/fencing-token.json
# The SBC's own profile decides how it runs: Enable activates control;
# IsProduction=true (installed default) requires this board.
# Unattended operation: JSON alert webhook and reminder interval.
#SBC_VACUUM_ALERT_WEBHOOK=https://hooks.example.com/services/...
#SBC_VACUUM_ALERT_TOKEN=
#SBC_VACUUM_ALERT_REMIND_SECONDS=1800
# Healthy polls (about 1 s each) before a device-error stop clears by itself.
#SBC_VACUUM_AUTO_RESUME_POLLS=10
#SBC_VACUUM_LOG_FORMAT=json
