[Unit]
Description=Local simulated Raspberry Pi vacuum GPIO controller
After=network-online.target
Wants=network-online.target
# Keep restarting for 24/7 service: the default start limit (5 starts in
# 10 s) would leave the unit failed for good after a short crash loop,
# for example while the I2C expanders come up at boot.
StartLimitIntervalSec=0

[Service]
# The service reports READY and pings the watchdog only while its control
# loop is alive; a hung loop is restarted (every output then goes off).
Type=notify
NotifyAccess=main
WatchdogSec=20
User=vboxuser
WorkingDirectory=/home/vboxuser/Project/Operations/Development/glasgow_service
Environment=PYTHONPATH=/home/vboxuser/Project/Operations/Development:/home/vboxuser/Project/Operations/Development/glasgow_service
EnvironmentFile=/etc/sbc-vacuum.env
ExecStart=/home/vboxuser/Project/Operations/.venv/bin/python -m glasgow_service.sbc_vacuum_app
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true
# Persistent home for the fencing token (/var/lib/sbc-vacuum).
StateDirectory=sbc-vacuum

[Install]
WantedBy=multi-user.target
