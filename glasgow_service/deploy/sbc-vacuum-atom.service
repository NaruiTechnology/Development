[Unit]
Description=Local simulated Raspberry Pi vacuum GPIO controller
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=vboxuser
WorkingDirectory=/home/vboxuser/Project/Operations/Development/glasgow_service
Environment=PYTHONPATH=/home/vboxuser/Project/Operations/Development:/home/vboxuser/Project/Operations/Development/glasgow_service
EnvironmentFile=/etc/sbc-vacuum.env
ExecStart=/home/vboxuser/Project/Operations/.venv/bin/python -m glasgow_service.sbc_vacuum_app
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
