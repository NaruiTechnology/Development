[Unit]
Description=Glasgow device service
After=network.target

[Service]
Type=exec
User=vboxuser
WorkingDirectory=/home/vboxuser/Project/Operations
Environment=PYTHONPATH=/home/vboxuser/Project/Operations/Development:/home/vboxuser/Project/Operations/Development/glasgow_service
Environment=GLASGOW_CONFIG=/home/vboxuser/Project/Operations/Development/GlasgowDataIO/Json/streamData.json
# GLASGOW_TOKEN (bearer auth) and other credentials come from the
# service account's secrets file; see secretstore/README.md.
EnvironmentFile=/etc/glasgow-svc.env
EnvironmentFile=-/home/vboxuser/.config/iobeam/secrets.env

ExecStart=/home/vboxuser/Project/Operations/.venv/bin/uvicorn glasgow_service.api:app \
          --host 127.0.0.1 --port 8765

Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
