[Unit]
Description=Local Ionbeam web backend
After=network-online.target

[Service]
Type=exec
WorkingDirectory=@BACKEND_ROOT@
Environment=GLASGOW_CONFIG=@OPERATIONS_ROOT@/Development/GlasgowDataIO/Json/streamData.json
Environment=GLASGOW_RESTART_CMD=@OPERATIONS_ROOT@/Scripts/restart-glasgow-service.sh
Environment=PATH=@NPM_DIR@:/usr/local/bin:/usr/bin:/bin
ExecStart=@NPM_BIN@ run dev
StandardOutput=append:@LOG_DIR@/ionbeam-web-backend.log
StandardError=append:@LOG_DIR@/ionbeam-web-backend.log
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=default.target
