[Unit]
Description=Raspberry Pi vacuum GPIO controller
After=network-online.target
Wants=network-online.target
# Keep restarting for 24/7 service: the default start limit (5 starts in
# 10 s) would leave the unit failed for good after a short crash loop,
# for example while the I2C expanders come up at boot.
StartLimitIntervalSec=0

[Service]
# The service reports READY and pings the watchdog only while its control
# loop is alive; a hung loop is restarted (every output then goes off).
Type=notify
NotifyAccess=main
WatchdogSec=20
# For a Raspberry Pi install, prefer deploy/sbc/ (install_sbc.py), which
# writes an equivalent unit plus the user, groups and config.txt it needs.
User=vacuum
Group=vacuum
# /dev/gpiochip* (gpio), /dev/i2c-1 (i2c), /dev/ttyAMA* (dialout).
SupplementaryGroups=gpio i2c dialout
# lgpio creates notification pipes (.lgd-nfy*) in its working directory, and
# /opt is read-only under ProtectSystem=strict: run from the state directory.
WorkingDirectory=/var/lib/sbc-vacuum
Environment=LG_WD=/var/lib/sbc-vacuum
EnvironmentFile=/etc/sbc-vacuum.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ionbeam/.venv/bin/python -m glasgow_service.sbc_vacuum_app
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=sbc-vacuum
ReadWritePaths=/var/lib/sbc-vacuum

[Install]
WantedBy=multi-user.target
