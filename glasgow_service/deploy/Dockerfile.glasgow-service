FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/Development:/app/Development/glasgow_service

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git libusb-1.0-0 libusb-1.0-0-dev usbutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Development/glasgow_service/requirements.txt /tmp/glasgow-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/glasgow-requirements.txt
COPY Development/glasgow_service Development/glasgow_service
COPY Development/GlasgowDataIO Development/GlasgowDataIO

EXPOSE 8765
CMD ["python", "-m", "uvicorn", "glasgow_service.api:app", "--host", "0.0.0.0", "--port", "8765"]
