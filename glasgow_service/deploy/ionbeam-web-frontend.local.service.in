[Unit]
Description=Local Ionbeam Vite frontend
After=network-online.target ionbeam-web-backend.service

[Service]
Type=exec
WorkingDirectory=@FRONTEND_ROOT@
Environment=PATH=@NPM_DIR@:/usr/local/bin:/usr/bin:/bin
ExecStart=@NPM_BIN@ run dev -- --host 127.0.0.1
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=default.target
