{
    "Header": {
        "Application": "Project Distribution Deploy",
        "TargetEnv": "Ubuntu 24.04 or newer",
        "Version": "1.0.0",
        "Description": "Builds dist_app.zip from local sources and bootstraps an Ubuntu host with all toolchains, the Glasgow service, and the ionbeam-web app."
    },
    "Deployment": {
        "SourceRoot": ".",
        "BuildScript": "buidCompiledDist.py",
        "DistDir": "dist_app",
        "DistZip": "dist_app.zip",
        "DeployRoot": "/home/vboxuser/Project/IobeamTech",
        "VenvDir": ".venv",
        "GlasgowConfig": "/home/vboxuser/Project/IobeamTech/Development/GlasgowDataIO/Json/streamData.json",
        "GlasgowLog": "/tmp/glasgow.log",
        "GlasgowServiceLog": "/tmp/glasgow.log",
        "GlasgowRepoUrl": "https://github.com/GlasgowEmbedded/glasgow",
        "GlasgowRepoDir": "glasgow",
        "NvmInstaller": "https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh",
        "IonbeamWebDir": "ionbeam-web"
    },
    "Actions": [
        {
            "buildDistribution": {
                "skip": true,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "python3 {} --source {} --dist {} --output {}",
                    "script": "buidCompiledDist.py",
                    "source": ".",
                    "dist": "dist_app",
                    "output": "dist_app.zip"
                },
                "timeout": 300.0,
                "args": {
                    "outputFiles": ["dist_app.zip"]
                }
            }
        },
        {
            "unzipDistribution": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "unzip -o {} -d {}",
                    "zip": "/home/vboxuser/Project/DeployWorkSpace/Development/DistributionDeploy/dist_app.zip",
                    "dest": "/home/vboxuser/Project/IobeamTech"
                },
                "timeout": 120.0
            }
        },
        {
            "setupVirtualEnv": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "bash -c 'cd {} && python3 -m venv {} && . {}/bin/activate && python -m pip install --upgrade pip'",
                    "root": "/home/vboxuser/Project/IobeamTech",
                    "venv": ".venv",
                    "venvAct": ".venv"
                },
                "timeout": 180.0
            }
        },
        {
            "installPipRequirements": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "python3 -m pip install -r {}/{}",
                    "root": "/home/vboxuser/Project/IobeamTech/Development",
                    "requirementsName": "requirements.txt",
                    "extraRequirements": [
                        "glasgow_service/requirements.txt"
                    ],
                    "venvDir": "/home/vboxuser/Project/IobeamTech/.venv",
                    "skipPrivateGitEditable": true,
                    "stopOnError": false,
                    "useBreakSystemPackages": true
                },
                "timeout": 600.0
            }
        },

        {
            "installNodeJS": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "bash",
                    "nvmInstaller": "https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh",
                    "nodeVersion": "--lts"
                },
                "timeout": 600.0
            }
        },
        {
            "installUuidRuntime": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "sudo apt install -y {}",
                    "package": "uuid-runtime"
                },
                "timeout": 180.0
            }
        },
        {
            "installToolchain": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "iterative",
                    "aptOptions": "-y --no-install-recommends",
                    "aptPackages": ["git", "pipx", "yosys", "uuid-runtime", "build-essential", "python3-dev"],
                    "pipxBootstrap": ["pipx ensurepath"],
                    "pipPackages": [
                        "Cython",
                        "debugpy",
                        "fx2",
                        "asyncio",
                        "libusb1",
                        "amaranth",
                        "tomlkit",
                        "numpy",
                        "matplotlib",
                        "PyQt6",
                        "tifffile",
                        "qasync",
                        "pyusb",
                        "debugpy"
                    ],
                    "useVenv": true,
                    "venvActivate": "/home/vboxuser/Project/IobeamTech/.venv/bin/activate",
                    "stopOnError": false
                },
                "timeout": 1800.0
            }
        },
        {
            "setupGlasgow": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "iterative",
                    "deployRoot": "/home/vboxuser/Project/IobeamTech",
                    "repoUrl": "https://github.com/GlasgowEmbedded/glasgow",
                    "repoDir": "glasgow",
                    "rulesSrc": "glasgow/config/70-glasgow.rules",
                    "rulesDst": "/etc/udev/rules.d",
                    "idVendor": "20b7",
                    "idProduct": "9db1",
                    "pipxTarget": "glasgow/software[builtin-toolchain]",
                    "stopOnError": true
                },
                "timeout": 900.0
            }
        },
        {
            "exportEnv": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "internal",
                    "bashrcPath": "~/.bashrc",
                    "exports": {
                        "GLASGOW_CONFIG": "/home/vboxuser/Project/IobeamTech/Development/GlasgowDataIO/Json/streamData.json"
                    }
                },
                "timeout": 5.0
            }
        },
        {
            "launchGlasgowService": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "root": "/home/vboxuser/Project/IobeamTech/Development/GlasgowDataIO/",
                    "venvActivate": "/home/vboxuser/Project/IobeamTech/.venv/bin/activate",
                    "exports": {
                        "GLASGOW_CONFIG": "/home/vboxuser/Project/IobeamTech/Development/GlasgowDataIO/Json/streamData.json",
                        "PYTHONPATH": "/home/vboxuser/Project/IobeamTech/Development:/home/vboxuser/Project/IobeamTech/Development/glasgow_service"
                    },
                    "command": "uvicorn glasgow_service.api:app --host 127.0.0.1 --port 8765 --log-level debug",
                    "log": "/tmp/glasgow.log",
                    "pid": "/tmp/glasgow.pid",
                    "title": "Glasgow Service",
                    "spawnTerminal": true
                },
                "timeout": 30.0,
                "args": {
                    "readinessDelay": 4.0
                }
            }
        },
        {
            "verifyGlasgowService": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "bash -c 'sleep {} && grep -E \"{}\" {} || true'",
                    "delay": "3",
                    "pattern": "chunk|valid|drain|in_flight",
                    "log": "/tmp/glasgow.log"
                },
                "timeout": 30.0
            }
        },
        {
            "setupIonbeamWeb": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "webRoot": "/home/vboxuser/Project/IobeamTech/Development/ionbeam-web",
                    "backendDir": "/home/vboxuser/Project/IobeamTech/Development/ionbeam-web/backend",
                    "frontendDir": "/home/vboxuser/Project/IobeamTech/Development/ionbeam-web/frontend",
                    "createBackendEnv": true,
                    "npmInstall": true,
                    "useNvm": true
                },
                "timeout": 600.0
            }
        },
        {
            "launchIonbeamWebBackend": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "dir": "/home/vboxuser/Project/IobeamTech/Development/ionbeam-web/backend",
                    "command": "npm run dev",
                    "useNvm": true,
                    "log": "/tmp/ionbeam-backend.log",
                    "pid": "/tmp/ionbeam-backend.pid",
                    "title": "Ionbeam Web Backend",
                    "spawnTerminal": true
                },
                "timeout": 60.0
            }
        },
        {
            "launchIonbeamWebFrontend": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "dir": "/home/vboxuser/Project/IobeamTech/Development/ionbeam-web/frontend",
                    "command": "npm run dev -- --host 127.0.0.1",
                    "useNvm": true,
                    "log": "/tmp/ionbeam-frontend.log",
                    "pid": "/tmp/ionbeam-frontend.pid",
                    "title": "Ionbeam Web Frontend",
                    "spawnTerminal": true
                },
                "timeout": 60.0
            }
        },
        {
            "verifyIonbeamWeb": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "initialDelay": 3.0,
                    "pollInterval": 1.0,
                    "urls": [
                        "http://127.0.0.1:4000/healthz",
                        "http://127.0.0.1:5173/"
                    ]
                },
                "timeout": 45.0
            }
        },
	{
	    "launchUI": {
		"skip": false,
		"transactionComplete": false,
		"actionData": {
		    "commandFormat": "internal",
		    "url": "http://127.0.0.1:5173",
		    "readinessTimeout": 30.0,
		    "pollInterval": 0.5,
		    "failOnNotReady": false
		},
		"timeout": 60.0
	    }
	}
    ],
    "LogName": "DistributionDeploy"
}
