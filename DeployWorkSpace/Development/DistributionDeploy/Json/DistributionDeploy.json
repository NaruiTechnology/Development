{
    "Header": {
        "Application": "Project Distribution Deploy",
        "TargetEnv": "Ubuntu 24.04 or newer",
        "Version": "1.0.0",
        "Description": "Builds dist_app.zip from local sources and bootstraps an Ubuntu host with all toolchains, the Glasgow service, and the ionbeam-web app."
    },
    "Deployment": {
        "SourceRoot": "Development/DistributionDeploy",
        "DistDir": "dist_app",
        "DistZip": "dist_app.zip",
        "DeployRoot": "~/IobeamPlatform",
        "VenvDir": ".venv",
        "IsProduction": false,
        "BackendHost": "127.0.0.1",
        "GlasgowConfig": "Development/GlasgowDataIO/Json/streamData.json",
        "GlasgowHost": "127.0.0.1",
        "GlasgowPort": 8765,
        "ProxyTargetHttp": "http://127.0.0.1:8765",
        "ProxyTargetWs": "ws://127.0.0.1:8765",
        "DatabaseHost": "localhost",
        "DatabasePort": 5432,
        "DatabaseName": "iobeam_admin",
        "DatabaseUser": "iobeam_admin_app",
        "GlasgowLog": "/tmp/glasgow.log",
        "GlasgowServiceLog": "/tmp/glasgow.log",
        "GlasgowRepoUrl": "https://github.com/GlasgowEmbedded/glasgow",
        "GlasgowRepoDir": "glasgow",
        "NvmInstaller": "https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh",
        "IonbeamWebDir": "ionbeam-web"
    },
    "Actions": [
        
        {
            "createDeployFolder": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "sudo rm -rf '$1' && mkdir -p '$1' && sudo chmod -R u+rwX,go+rX '$1'"
                },
                "timeout": 30.0
            }
        },
        {
            "unzipDistribution": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "unzip -o {} -d {}",
                    "zip": "Development/DistributionDeploy/dist_app*.zip",
                    "dest": "."
                },
                "timeout": 120.0
            }
        },
        {
            "setupVirtualEnv": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "bash -c 'cd {} && python3 -m venv {} && . {}/bin/activate && python -m pip install --upgrade pip'",
                    "root": ".",
                    "venv": ".venv",
                    "venvAct": ".venv"
                },
                "timeout": 180.0
            }
        },
        {
            "installPipRequirements": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "python3 -m pip install -r {}/{}",
                    "root": "Development",
                    "requirementsName": "requirements.txt",
                    "extraRequirements": [
                        "glasgow_service/requirements.txt"
                    ],
                    "venvDir": ".venv",
                    "skipPrivateGitEditable": true,
                    "stopOnError": false,
                    "useBreakSystemPackages": true
                },
                "timeout": 600.0
            }
        },

        {
            "installNodeJS": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "bash",
                    "nvmInstaller": "https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh",
                    "nodeVersion": "--lts"
                },
                "timeout": 600.0
            }
        },
        {
            "installUuidRuntime": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "sudo apt install -y {}",
                    "package": "uuid-runtime"
                },
                "timeout": 180.0
            }
        },
        {
            "installToolchain": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "iterative",
                    "aptOptions": "-y --no-install-recommends",
                    "aptPackages": ["git", "pipx", "yosys", "uuid-runtime", "build-essential", "python3-dev"],
                    "pipxBootstrap": ["pipx ensurepath"],
                    "pipPackages": [
                        "Cython",
                        "debugpy",
                        "fx2",
                        "asyncio",
                        "libusb1",
                        "amaranth",
                        "tomlkit",
                        "numpy",
                        "matplotlib",
                        "PyQt6",
                        "tifffile",
                        "qasync",
                        "pyusb",
                        "debugpy",
                        "amaranth"
                    ],
                    "useVenv": true,
                    "venvActivate": ".venv/bin/activate",
                    "stopOnError": false
                },
                "timeout": 1800.0
            }
        },
        {
            "installPostgreSQL": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "sudo apt-get update && sudo apt-get install -y postgresql postgresql-contrib postgresql-client && sudo systemctl enable --now postgresql"
                },
                "timeout": 900.0
            }
        },
        {
            "setupIobeamAdminDb": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "databaseName": "iobeam_admin",
                    "databaseRole": "iobeam_admin_app",
                    "databaseOwnerRole": "iobeam_admin_owner",
                    "databaseOwnerMembers": [
                        "lyh1154@gmail.com",
                        "yuyao.jiang@ionbeamtech.com"
                    ],
                    "adminConfigFile": "Development/IobeamAdmin/Json/IobeamAdmin.json",
                    "adminDbConfigFile": "Development/IobeamAdmin/Json/IobeamAdminDb.json",
                    "schemaFile": "Development/IobeamAdmin/Sql/001_schema.sql",
                    "seedFile": "Development/IobeamAdmin/Sql/002_seed_root_user.sql",
                    "ProductionConfig": {
                        "databaseHost": "",
                        "adminDbPort": "",
                        "adminDbSslMode": ""
                    },
                    "installCommand": "sudo apt-get update && sudo apt-get install -y postgresql postgresql-contrib postgresql-client dbeaver-ce || sudo apt-get install -y postgresql postgresql-contrib postgresql-client"
                },
                "timeout": 900.0
            }
        },
        {
            "setupGlasgow": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "iterative",
                    "deployRoot": ".",
                    "repoUrl": "https://github.com/GlasgowEmbedded/glasgow",
                    "repoDir": "glasgow",
                    "rulesSrc": "glasgow/config/70-glasgow.rules",
                    "rulesDst": "/etc/udev/rules.d",
                    "idVendor": "20b7",
                    "idProduct": "9db1",
                    "pipxTarget": "glasgow/software[builtin-toolchain]",
                    "pipxPython": "python3.13",
                    "pipxRequired": false,
                    "pyprojectPath": "glasgow/software/pyproject.toml",
                    "pythonRequires": ">=3.12.3,<4",
                    "stopOnError": true
                },
                "timeout": 900.0
            }
        },
        {
            "exportEnv": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "internal",
                    "bashrcPath": "~/.bashrc",
                    "exports": {
                        "GLASGOW_TOKEN": {
                            "value": "376e6207faf8425219a652914085bfb394a97582bbd0a8692042d77e8971a9ee",
                            "resolve": false
                        },
                        "GLASGOW_CONFIG": "Development/GlasgowDataIO/Json/streamData.json"
                    }
                },
                "timeout": 5.0
            }
        },
        {
            "launchGlasgowService": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "root": "Development/GlasgowDataIO",
                    "venvActivate": ".venv/bin/activate",
                    "exports": {
                        "GLASGOW_TOKEN": {
                            "value": "376e6207faf8425219a652914085bfb394a97582bbd0a8692042d77e8971a9ee",
                            "resolve": false
                        },
                        "GLASGOW_CONFIG": "Development/GlasgowDataIO/Json/streamData.json",
                        "PYTHONPATH": [
                            "Development",
                            "Development/glasgow_service"
                        ]
                    },
                    "command": "uvicorn glasgow_service.api:app --host 127.0.0.1 --port 8765 --log-level debug",
                    "log": "/tmp/glasgow.log",
                    "pid": "/tmp/glasgow.pid",
                    "port": 8765,
                    "stopPatterns": [
                        "uvicorn glasgow_service.api:app .*--port 8765",
                        "glasgow_service.api:app"
                    ],
                    "title": "Glasgow Service",
                    "spawnTerminal": true
                },
                "timeout": 30.0,
                "args": {
                    "readinessDelay": 4.0
                }
            }
        },
        {
            "verifyGlasgowService": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "commandFormat": "bash -c 'sleep {} && grep -E \"{}\" {} || true'",
                    "delay": "3",
                    "pattern": "chunk|valid|drain|in_flight",
                    "log": "/tmp/glasgow.log"
                },
                "timeout": 30.0
            }
        },
        {
            "setupIonbeamWeb": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "webRoot": "Development/ionbeam-web",
                    "createBackendEnv": true,
                    "npmInstall": true,
                    "useNvm": true,
                    "backendHost": "127.0.0.1",
                    "adminDbConfigFile": "Development/IobeamAdmin/Json/IobeamAdminDb.json",
                    "ProductionConfig": {
                        "backendHost": "",
                        "proxyTargetHttp": "",
                        "proxyTargetWs": "",
                        "adminDbHost": "",
                        "adminDbPort": "",
                        "adminDbSslMode": ""
                    }
                },
                "timeout": 600.0
            }
        },
        {
            "launchIonbeamWebBackend": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "dir": "Development/ionbeam-web/backend",
                    "command": "npm run dev",
                    "useNvm": true,
                    "exports": {
                        "GLASGOW_TOKEN": {
                            "value": "376e6207faf8425219a652914085bfb394a97582bbd0a8692042d77e8971a9ee",
                            "resolve": false
                        },
                        "GLASGOW_CONFIG": "Development/GlasgowDataIO/Json/streamData.json"
                    },
                    "log": "/tmp/ionbeam-backend.log",
                    "pid": "/tmp/ionbeam-backend.pid",
                    "port": 4000,
                    "stopPatterns": [
                        "IobeamPlatform/Development/ionbeam-web/backend/src/server.ts",
                        "ionbeam-web/backend.*tsx watch src/server.ts"
                    ],
                    "ProductionConfig": {
                        "command": "",
                        "spawnTerminal": ""
                    },
                    "title": "Ionbeam Web Backend",
                    "spawnTerminal": true
                },
                "ProductionConfig": {
                    "command": "sudo systemctl restart ionbeam-web.service",
                    "spawnTerminal": false
                },
                "timeout": 60.0
            }
        },
        {
            "launchIonbeamWebFrontend": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "dir": "Development/ionbeam-web/frontend",
                    "command": "npm run dev -- --host 127.0.0.1",
                    "useNvm": true,
                    "exports": {
                        "VITE_PROXY_TARGET_HTTP": "http://127.0.0.1:4000",
                        "VITE_PROXY_TARGET_WS": "ws://127.0.0.1:4000"
                    },
                    "log": "/tmp/ionbeam-frontend.log",
                    "pid": "/tmp/ionbeam-frontend.pid",
                    "port": 5173,
                    "stopPatterns": [
                        "IobeamPlatform/Development/ionbeam-web/frontend/node_modules/.bin/vite",
                        "ionbeam-web/frontend.*vite --host 127.0.0.1"
                    ],
                    "ProductionConfig": {
                        "command": "",
                        "spawnTerminal": ""
                    },
                    "title": "Ionbeam Web Frontend",
                    "spawnTerminal": true
                },
                "ProductionConfig": {
                    "command": "true",
                    "port": 0,
                    "spawnTerminal": false
                },
                "timeout": 60.0
            }
        },
        {
            "verifyIonbeamWeb": {
                "skip": false,
                "transactionComplete": false,
                "actionData": {
                    "initialDelay": 3.0,
                    "pollInterval": 1.0,
                    "checks": [
                        {
                            "url": "http://127.0.0.1:4000/healthz",
                            "expectedStatus": 200,
                            "jsonContains": {
                                "ok": true
                            }
                        },
                        {
                            "url": "http://127.0.0.1:4000/api/admin/iobeam/auth/current-account",
                            "expectedStatus": 200,
                            "jsonContains": {
                                "ok": true
                            }
                        },
                        {
                            "url": "http://127.0.0.1:4000/api/admin/iobeam/reports/activity?days=90",
                            "expectedStatus": 200,
                            "jsonContains": {
                                "ok": true
                            }
                        },
                        {
                            "url": "http://127.0.0.1:4000/api/admin/iobeam/equipment",
                            "expectedStatus": 200,
                            "jsonContains": {
                                "ok": true
                            }
                        },
                        {
                            "url": "http://localhost:5173/control",
                            "expectedStatus": 200
                        }
                    ],
                    "ProductionConfig": {
                        "checks": [
                            {
                                "url": "https://ionbeamtech.com/healthz",
                                "expectedStatus": 200,
                                "jsonContains": {
                                    "ok": true
                                }
                            },
                            {
                                "url": "https://ionbeamtech.com/control",
                                "expectedStatus": 200
                            }
                        ]
                    }
                },
                "timeout": 45.0
            }
        },
	{
	    "launchUI": {
		"skip": false,
		"transactionComplete": false,
		"actionData": {
		    "commandFormat": "internal",
		    "url": "http://localhost:5173/control",
		    "readinessTimeout": 30.0,
		    "pollInterval": 0.5,
		    "failOnNotReady": false,
		    "ProductionConfig": {
		        "url": "https://ionbeamtech.com/control"
		    }
		},
		"timeout": 60.0
	    }
	}
    ],
    "LogName": "DistributionDeploy"
}
