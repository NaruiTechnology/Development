				"timeout":600.0
			}
		},
		{
			"launchIonbeamWebBackend":{
				"skip":false,
				"transactionComplete":false,
				"actionData":{
					"dir":"C:\\Project\\Iobeam\\Deploy\\ionbeam-web\\backend",
					"command":"npm run dev",
					"useNvm":false,
					"log":"C:\\Project\\Iobeam\\Deploy\\Logs\\ionbeam-backend.log",
					"pid":"C:\\Project\\Iobeam\\Deploy\\Logs\\ionbeam-backend.pid",
					"title":"Ionbeam Web Backend",
					"spawnTerminal":true
				},
				"timeout":60.0
			}
		},
		{
			"launchIonbeamWebFrontend":{
				"skip":false,
				"transactionComplete":false,
				"actionData":{
					"dir":"C:\\Project\\Iobeam\\Deploy\\ionbeam-web\\frontend",
					"command":"npm run dev -- --host 127.0.0.1",
					"useNvm":false,
					"log":"C:\\Project\\Iobeam\\Deploy\\Logs\\ionbeam-frontend.log",
					"pid":"C:\\Project\\Iobeam\\Deploy\\Logs\\ionbeam-frontend.pid",
					"title":"Ionbeam Web Frontend",
					"spawnTerminal":true
				},
				"timeout":60.0
			}
		},
		{
			"verifyIonbeamWeb":{
				"skip":false,
				"transactionComplete":false,
				"actionData":{
					"initialDelay":3.0,
					"pollInterval":1.0,
					"urls":[
						"http://127.0.0.1:4000/healthz",
						"http://127.0.0.1:5173/"
					]
				},
				"timeout":45.0
			}
		},
		{
			"launchUI":{
				"skip":false,
				"transactionComplete":false,
				"actionData":{
					"commandFormat":"internal",
					"url":"http://127.0.0.1:5173",
					"readinessTimeout":30.0,
					"pollInterval":0.5,
					"failOnNotReady":false
				},
				"timeout":60.0
