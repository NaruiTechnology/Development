# Where the Python FastAPI glasgow_service is listening.
# Default matches the README of glasgow_service: 127.0.0.1:8765.
PROXY_TARGET_HTTP=http://127.0.0.1:8765
PROXY_TARGET_WS=ws://127.0.0.1:8765

# Vacuum commands go through the elected failover executor. This keeps scan
# traffic on Glasgow while GPIO control is redirected to the SBC leader.
VACUUM_CONTROLLER_URL=http://127.0.0.1:8780

# Bearer token for the FastAPI service. Injected server-side; never sent
# to the browser. Leave empty for open localhost dev mode.
GLASGOW_TOKEN=${GLASGOW_TOKEN}

# Where this Node proxy listens.
PORT=4000

# Set MOCK=1 to bypass the FastAPI service and synthesize chunks so the UI
# can be developed and demoed without a Glasgow attached.
MOCK=0

# Path to the built React app. Used in `npm start`. In `npm run dev` the
# React dev server runs on its own port and proxies through this one.
STATIC_DIR=../frontend/dist

# JSON config edited by the settings dialog.
GLASGOW_CONFIG=C:\Project\IobeamTech\Development\GlasgowDataIO\Json\streamData.json
IOBEAM_ADMIN_CONFIG=C:\Project\IobeamTech\Development\IobeamAdmin\Json\IobeamAdmin.json

# PostgreSQL-backed admin/sign-in settings.
IOBEAM_ADMIN_DB_HOST=localhost
IOBEAM_ADMIN_DB_PORT=5432
IOBEAM_ADMIN_DB_NAME=iobeam_admin
IOBEAM_ADMIN_DB_USER=postgres
# IOBEAM_ADMIN_DB_PASSWORD=

# Optional real SMS delivery. Without Twilio credentials, the backend logs a
# mock verification code for local development.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Command run after saving/restoring config. By default the backend runs
# scripts/restart-glasgow-service.ps1 on Windows and
# scripts/restart-glasgow-service.sh on Linux.
# Override this in production if the service is managed elsewhere, for example:
#   GLASGOW_RESTART_CMD=powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\Project\IobeamTech\Development\ionbeam-web\backend\scripts\restart-glasgow-service.ps1
# GLASGOW_RESTART_CMD=

# Restart this Node backend after a successful Glasgow restart. Windows keeps
# this disabled by default so the Vite proxy can receive the save response.
IONBEAM_BACKEND_RESTART_AFTER_GLASGOW=0
# IONBEAM_BACKEND_RESTART_CMD=
GLASGOW_CONFIG_STRICT=0

# Operation telemetry database. Defaults to the same host/user/password as
# the admin DB, but uses the separate `operation_data` database.
# IOBEAM_OPERATION_DB_CONFIG=
# IOBEAM_OPERATION_DB_HOST=
# IOBEAM_OPERATION_DB_PORT=5432
# IOBEAM_OPERATION_DB_NAME=operation_data
# IOBEAM_OPERATION_DB_USER=
# IOBEAM_OPERATION_DB_PASSWORD=
# IOBEAM_OPERATION_DB_SSLMODE=
# IOBEAM_OPERATION_DB_COMMAND_TIMEOUT_MS=30000

# Outbound email for scan-role approval requests. Fill these to send real email.
# Example for STARTTLS: SMTP_HOST=smtp.example.com, SMTP_PORT=587, SMTP_SECURE=false
# Example for implicit TLS: SMTP_HOST=smtp.example.com, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
